{
    "name": "to-visual/trash-laravel",
    "description": "The visualise trash example, ported to Laravel. Same routes, responses and test names as trash-django.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "~8.2.35 || ~8.3.36 || ~8.4.27 || ~8.5.12",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
