__pycache__/
.DS_Store

# skill-creator eval scratch (prototype-workspace, scrub-workspace, …)
*-workspace/

# explain-diff skill (kept local, not committed)
explain-diff/

# Throwaway pre-build design sketches
docs/sketches/

# Stray session-state artifact
/:memory:.ses

# throwaway experiments (not committed) — but keep the skill-router source.
# data/, results/, report.html and .venv/ stay out: they hold real session text
# (regenerated locally by src/extract.py) or machine-specific bytes.
experiments/*
!experiments/skill-router/
experiments/skill-router/*
!experiments/skill-router/src/
!experiments/skill-router/README.md
!experiments/skill-router/requirements.txt
experiments/skill-router/src/__pycache__/
